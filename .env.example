# ── Neon PostgreSQL
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/hrbot?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/hrbot?ssl=require

# ── MinIO 
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=hrbot-documents
MINIO_USE_SSL=false

# ── Redis 
REDIS_PASSWORD=CHANGE_ME

# ── OpenAI 
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=3072
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_SIM_THRESHOLD=0.2
HEALTH_OPENAI_WARN_MS=1800
HEALTH_HALL_WARN_THRESHOLD=0.45

# ── NextAuth 
NEXTAUTH_SECRET=CHANGE_ME_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000
PUBLIC_SESSION_SECRET=CHANGE_ME_at_least_32_chars
ADMIN_EMAIL=admin@hr.local
ADMIN_PASSWORD=Admin123456!

# ── Internal routing (host runtime)
PYTHON_BACKEND_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:3000

# ── Ingest pipeline
INGEST_TMP_DIR=/tmp/rag
INGEST_MAX_FILE_SIZE_MB=15
INGEST_IMAGE_MAX_FILE_SIZE_MB=5
INGEST_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp
IMAGE_PREVIEW_EXPIRES_SECONDS=3600

# ── Logging (backend)
LOG_LEVEL=INFO
LOG_JSON=false
LOG_TO_FILE=true
LOG_FILE_PATH=logs/backend.log

# ── Prod (optional)
APP_DOMAIN=localhost
